---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { RecordSightingForm } from "@/components/sightings/RecordSightingForm";
---

<Layout title="Record a sighting">
  <div class="bg-cosmic min-h-screen p-4">
    <Topbar />
    <div class="mx-auto max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Record a sighting
      </h1>
      <RecordSightingForm client:load />
    </div>
  </div>
</Layout>
